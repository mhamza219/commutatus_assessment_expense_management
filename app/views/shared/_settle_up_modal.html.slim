#settleUpModal.modal.fade aria-hidden="true" aria-labelledby="settleUpModalLabel" tabindex="-1"
  .modal-dialog
    .modal-content
      = form_with model: @settlement, url: settlements_path, method: :post, local: true do |f|
        .modal-header.bg-success.text-white
          h5#settleUpModalLabel.modal-title 🤝 Settle Up / Record a Payment
          button.btn-close.btn-close-white aria-label="Close" data-bs-dismiss="modal" type="button"

        .modal-body
          .mb-3
            label.form-label.fw-bold Who are you paying?
            = f.select :payee_id, options_for_select(@friends.map { |f| [f.name, f.id] }, @settlement.payee_id), {}, class: 'form-select', required: true

          .mb-3
            = f.label :amount, "Amount Paid ($)", class: 'form-label fw-bold'
            = f.number_field :amount, step: 0.01, min: 0.01, placeholder: '0.00', class: 'form-control', required: true

          .mb-3
            = f.label :date, "Payment Date", class: 'form-label fw-bold'
            = f.date_field :date, value: Date.current, class: 'form-control'

          .mb-3
            = f.label :notes, "Notes (optional)", class: 'form-label fw-bold'
            = f.text_area :notes, rows: 2, placeholder: 'e.g. Cash, Venmo, UPI, Bank Transfer', class: 'form-control'

        .modal-footer
          button.btn.btn-secondary data-bs-dismiss="modal" type="button" Cancel
          = f.submit "Record Payment", class: 'btn btn-success fw-bold'
